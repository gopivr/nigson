{
  "provider": "keycloak",
  "version": "26.8.0",
  "image": "quay.io/keycloak/keycloak:26.8.0@sha256:b0f60d489d51c5d113390bdf5461d4c06e6051be026c05549f2e1e10ec352bcc",
  "postgresImage": "postgres:18.6@sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722",
  "algorithms": ["RS256", "ES256"],
  "accessTokenType": "Bearer",
  "clockSkewSeconds": 60,
  "jwksCacheSeconds": 300,
  "jwksRefreshMinimumSeconds": 5,
  "jwksMaxBytes": 65536,
  "tokenMaxBytes": 16384,
  "replicas": 2,
  "discovery": "jdbc-ping",
  "persistentSessions": true,
  "domainRolesAuthoritative": "commerce",
  "publicPaths": ["/realms/{realm}/*", "/resources/*", "/.well-known/openid-configuration"],
  "privateOnly": ["/admin", "/realms/master", "/health", "/metrics", "/management"]
}
