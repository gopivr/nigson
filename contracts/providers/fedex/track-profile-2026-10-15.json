{
  "profileVersion": 1,
  "reviewedOn": "2026-10-15",
  "source": "https://developer.fedex.com/api/en-us/catalog/track/v1/docs.html",
  "upstream": {
    "resource": "https://developer.fedex.com/wirc/json/api_groups/Track/TrackingNumbers-Resource.json",
    "title": "Basic Integrated Visibility",
    "version": "1.0.0",
    "openapi": "3.0.0",
    "sha256": "e404a7e47445d20eb845f710019db81d8488e683161c652bfeeb33854366ee97"
  },
  "scope": "Reviewed conservative tracking interpretation; synthetic fixture qualification is separate from account/route/actual scan qualification. No provider text or recipient/location information is persisted.",
  "request": {
    "method": "POST",
    "path": "/track/v1/trackingnumbers",
    "fields": [
      "includeDetailedScans",
      "trackingInfo"
    ],
    "maximumTrackingNumbers": 30,
    "trackingPath": "trackingInfo[].trackingNumberInfo.trackingNumber"
  },
  "response": {
    "root": "output.completeTrackResults[]",
    "result": "trackResults[]",
    "identity": "trackingNumberInfo.trackingNumber",
    "status": "latestStatusDetail.code",
    "scanTimestamp": "scanEvents[].date",
    "scanCode": "scanEvents[].eventType",
    "deliveryTimestamp": "dateAndTimes[type=ACTUAL_DELIVERY].dateTime"
  },
  "localInterpretation": {
    "OC": "label-only; no dispatch",
    "PU": "carrier possession evidence",
    "IT": "transit evidence",
    "OD": "transit evidence",
    "DL": "all physical pieces delivered with actual timestamp",
    "CA": "all physical pieces cancelled",
    "SE": "exception",
    "DE": "exception",
    "unknown": "visible unavailable; no guessed transition"
  },
  "guards": [
    "exact unique physical-piece coverage",
    "one unambiguous track result per requested number",
    "matching scan code and offset-bearing timestamp",
    "future beyond five seconds rejected",
    "delivery requires ACTUAL_DELIVERY",
    "source physical handover remains authoritative",
    "no provider location/recipient/text retained"
  ]
}
