{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaxPolicy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "rate",
    "rounding",
    "approvalReference"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "enum": [
        "NONE",
        "EXCLUSIVE",
        "INCLUSIVE"
      ]
    },
    "rate": {
      "type": "string",
      "pattern": "^(0(\\.[0-9]{1,18})?|1(\\.0{1,18})?)$"
    },
    "rounding": {
      "const": "HALF_UP"
    },
    "approvalReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "NONE"
          }
        }
      },
      "then": {
        "properties": {
          "rate": {
            "type": "string",
            "pattern": "^0(\\.0{1,18})?$"
          }
        }
      }
    }
  ]
}
