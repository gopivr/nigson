# Local application settings. Provider credentials must be supplied through a
# secret manager or ignored local environment file; no demo provider credentials.
APP_ENV=local
LAUNCH_MARKET=NG
LAUNCH_COUNTRY=NG
LAUNCH_CURRENCY=NGN
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=local-bootstrap
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=mock-local-identity-admin
COMMERCE_DB_PASSWORD=mock-commerce-runtime
EXPERIENCE_DB_PASSWORD=mock-experience-runtime
INTEGRATION_DB_PASSWORD=mock-integration-runtime
AI_DB_PASSWORD=mock-ai-runtime
COMMERCE_MIGRATION_PASSWORD=mock-commerce-migration
EXPERIENCE_MIGRATION_PASSWORD=mock-experience-migration
INTEGRATION_MIGRATION_PASSWORD=mock-integration-migration
AI_MIGRATION_PASSWORD=mock-ai-migration
# Genuine secrets must be supplied as environment-specific secret references.
# No live account, sender, template, tax or price policy is seeded here.
# AI gateway stays fail-closed until approved provider, model and rate references
# are supplied by deployment configuration. These values are intentionally blank.
NIGSON_AI_BEDROCK_REGION=
NIGSON_AI_APPROVED_BEDROCK_MODELS=
NIGSON_AI_RATE_APPROVAL_REFERENCES=
NIGSON_AI_PROVIDER_MODE=BEDROCK

# Explicit cumulative product release gate; does not activate any business feature.
SCHEMA_RELEASE=BP1

# Local private APIs fail closed when enabled; provide values from local KMS/key material.
NIGSON_SECURITY_ENABLED=false
NIGSON_PRIVATE_PEER_CIDRS=
NIGSON_ACTOR_KMS_KEY=
NIGSON_ACTOR_KEY_ID=
NIGSON_ACTOR_PUBLIC_KEY=
NIGSON_ACTOR_PUBLIC_KEYS=
NIGSON_COMMERCE_WORKLOAD_SECRET=
NIGSON_SESSION_KEY_REVISION=
NIGSON_SESSION_KMS_KEY=
NIGSON_SESSION_WRAPPED_KEY=
NIGSON_SESSION_PREVIOUS_WRAPPED_KEYS={}
NIGSON_SESSION_LOCAL_KEY=

# Local application signup/sign-in endpoints; server-side only service credentials.
NIGSON_REGISTRATION_ENABLED=true
NIGSON_REGISTRATION_CLIENT_ID=nigson-registration
NIGSON_REGISTRATION_CLIENT_SECRET=mock-registration-local-secret-32-bytes
NIGSON_BFF_CALLBACK=http://localhost:4200/bff/callback
NIGSON_BFF_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8090
NIGSON_BFF_RETURN_PATHS=/,/account,/shop,/checkout,/admin,/distributor

# Application runtime uses official provider APIs; local supports TEST, production requires LIVE. Configure real account
# values outside source control. Enable adapters only after all required values are configured.
NIGSON_PROVIDERS_ENABLED=false
PAYSTACK_MODE=LIVE
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
TWILIO_MODE=LIVE
TWILIO_BASE_URL=https://api.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
EMAIL_MODE=LIVE
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Career Sheets delivery remains disabled until recipient and spreadsheet policy are approved.
# NIGSON_SHEETS_MODE is unset until the live Google Sheets account is configured.
NIGSON_CAREER_SHEET_RECIPIENT_GROUP=
NIGSON_CAREER_SHEET_SPREADSHEET_KEY=
NIGSON_CAREER_SHEET_TAB=
NIGSON_GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Supply this only from the environment secret manager; never commit a private key.
NIGSON_GOOGLE_PRIVATE_KEY_PKCS8_BASE64=
NIGSON_CAREER_SHEETS_ROW_HASH_KEY_BASE64=

# Distributor intake stays disabled until approved proof types and recipient group are supplied.
NIGSON_DISTRIBUTOR_REQUIRED_DOCUMENT_TYPES=
NIGSON_DISTRIBUTOR_RECIPIENT_GROUP=
# Use mock only in local/test; live environments require API-117 workload credentials and HTTPS.
NIGSON_DISTRIBUTOR_COMMERCE_MODE=
NIGSON_DISTRIBUTOR_WORKLOAD_CLIENT_ID=
NIGSON_DISTRIBUTOR_WORKLOAD_CLIENT_SECRET=

# Quote lead outbox delivery remains disabled until the approved recipient group exists.
NIGSON_LEAD_RECIPIENT_GROUP=
NIGSON_LEAD_ADMIN_BASE_URL=
# Public lead intake stays disabled until real Google reCAPTCHA and database rate-limit settings are configured.
NIGSON_LEADS_ANTISPAM_MODE=
NIGSON_LEADS_LOCAL_ANTISPAM_HMAC_KEY=
NIGSON_LEADS_RATE_LIMIT_MODE=
NIGSON_LEADS_RECAPTCHA_SECRET=
NIGSON_LEADS_RECAPTCHA_HOSTNAMES=
NIGSON_LEADS_RECAPTCHA_ACTION=lead_submit
NIGSON_LEADS_RECAPTCHA_MIN_SCORE=0.5
NIGSON_LEADS_RATE_LIMIT_PER_MINUTE=10
NIGSON_LEADS_RATE_LIMIT_HMAC_KEY=
NIGSON_LEADS_TRUSTED_PROXY_CIDRS=
# Commerce SKU eligibility uses the private owner API; no cross-schema query or mock fallback.
NIGSON_QUOTES_ENABLED=false
# Local-only synthetic storefront fixture. Refused outside APP_ENV=local; never
# valid production approval evidence. Populate with scripts/local/seed_local_catalogue.py.
NIGSON_LOCAL_SYNTHETIC_SELLING=false
NIGSON_QUOTE_CATALOGUE_MODE=
NIGSON_QUOTE_CATALOGUE_WORKLOAD_CLIENT_ID=
NIGSON_QUOTE_CATALOGUE_WORKLOAD_CLIENT_SECRET=

# Optional user-selected partners; credentials belong in ignored .local/provider-accounts.env.
NIGSON_MESSAGING_PROVIDER=TERMII
NIGSON_TERMII_ENABLED=false
TERMII_MODE=LIVE
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_API_KEY=
TERMII_SENDER_ID=UNSET
NIGSON_PANDAGO_ENABLED=false
# Commerce delivery quotes stay off unless the explicit LIVE-only PandaGo overlay is used.
NIGSON_CARRIER_QUOTES_ENABLED=false
NIGSON_CARRIER_PROVIDER=PANDAGO
NIGSON_CARRIER_ACCOUNT_FINGERPRINT=
NIGSON_FULFILLMENT_ENABLED=false
NIGSON_FULFILLMENT_MODE=
NIGSON_FULFILLMENT_APPROVAL=
NIGSON_FULFILLMENT_APPROVAL_UNTIL=
NIGSON_PANDAGO_ACCOUNT_FINGERPRINT=
NIGSON_PANDAGO_APPROVAL=
NIGSON_PANDAGO_APPROVAL_UNTIL=
NIGSON_PAYSTACK_APPROVAL=
# Optional docker-compose.pandago.yml is LIVE-only and uses a file secret, never an inline PEM.
PANDAGO_MODE=LIVE
PANDAGO_BASE_URL=https://ondemand-api-glovoapp.deliveryhero.io
PANDAGO_AUTH_BASE_URL=https://sts.deliveryhero.io
PANDAGO_CLIENT_ID=
PANDAGO_KEY_ID=
PANDAGO_SCOPE=pandago.api.ng.*
PANDAGO_CLIENT_VENDOR_ID=
PANDAGO_PRIVATE_KEY_FILE=

# Server-side address lookup; no coordinates requested from customers.
NIGSON_GEOCODING_PROVIDER=
GOOGLE_MAP_API_KEY=
