# Local-only launch metadata and synthetic provider credentials; never use on genuine endpoints.
APP_ENV=local
LAUNCH_MARKET=NG
LAUNCH_COUNTRY=NG
LAUNCH_CURRENCY=NGN
FIXTURE_PROFILE=foundation
KEYCLOAK_FIXTURE_PASSWORD=mock-local-user
COMMERCE_DB_PASSWORD=mock-commerce-runtime
EXPERIENCE_DB_PASSWORD=mock-experience-runtime
INTEGRATION_DB_PASSWORD=mock-integration-runtime
AI_DB_PASSWORD=mock-ai-runtime
COMMERCE_MIGRATION_PASSWORD=mock-commerce-migration
EXPERIENCE_MIGRATION_PASSWORD=mock-experience-migration
INTEGRATION_MIGRATION_PASSWORD=mock-integration-migration
AI_MIGRATION_PASSWORD=mock-ai-migration
# Genuine secrets must be supplied as environment-specific secret references.
# No live account, sender, template, tax or price policy is seeded here.
# AI gateway stays fail-closed until approved provider, model and rate references
# are supplied by deployment configuration. These values are intentionally blank.
NIGSON_AI_BEDROCK_REGION=
NIGSON_AI_APPROVED_BEDROCK_MODELS=
NIGSON_AI_RATE_APPROVAL_REFERENCES=

# Explicit cumulative product release gate; does not activate any business feature.
SCHEMA_RELEASE=BP1

# Synthetic provider state is private to the Compose network. No real account is implied.
PAYSTACK_SECRET_KEY=sk_mock_nigson
FEDEX_CLIENT_ID=mock-fedex-client
FEDEX_CLIENT_SECRET=mock-fedex-secret
FEDEX_ACCOUNT_NUMBER=mock-fedex-account
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=mock-twilio-token
TWILIO_MESSAGING_SERVICE_SID=MG00000000000000000000000000000000

# Career Sheets delivery remains disabled until recipient and spreadsheet policy are approved.
# NIGSON_SHEETS_MODE is intentionally unset; local acceptance selects mock explicitly.
NIGSON_CAREER_SHEET_RECIPIENT_GROUP=
NIGSON_CAREER_SHEET_SPREADSHEET_KEY=
NIGSON_CAREER_SHEET_TAB=
NIGSON_GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Supply this only from the environment secret manager; never commit a private key.
NIGSON_GOOGLE_PRIVATE_KEY_PKCS8_BASE64=
NIGSON_CAREER_SHEETS_ROW_HASH_KEY_BASE64=

# Distributor intake stays disabled until approved proof types and recipient group are supplied.
NIGSON_DISTRIBUTOR_REQUIRED_DOCUMENT_TYPES=
NIGSON_DISTRIBUTOR_RECIPIENT_GROUP=
# Use mock only in local/test; live environments require API-117 workload credentials and HTTPS.
NIGSON_DISTRIBUTOR_COMMERCE_MODE=
NIGSON_DISTRIBUTOR_WORKLOAD_CLIENT_ID=
NIGSON_DISTRIBUTOR_WORKLOAD_CLIENT_SECRET=

# Quote lead outbox delivery remains disabled until the approved recipient group exists.
NIGSON_LEAD_RECIPIENT_GROUP=
# Commerce SKU eligibility uses the private owner API; no cross-schema query or mock fallback.
NIGSON_QUOTE_CATALOGUE_MODE=
NIGSON_QUOTE_CATALOGUE_WORKLOAD_CLIENT_ID=
NIGSON_QUOTE_CATALOGUE_WORKLOAD_CLIENT_SECRET=
