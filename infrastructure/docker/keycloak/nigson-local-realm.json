{
  "realm": "nigson-local",
  "id": "nigson-local",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER"
      },
      {
        "name": "CONTENT_EDITOR"
      },
      {
        "name": "CONTENT_PUBLISHER"
      },
      {
        "name": "SALES"
      },
      {
        "name": "OPERATIONS"
      },
      {
        "name": "FINANCE"
      },
      {
        "name": "ANALYST"
      },
      {
        "name": "ADMIN"
      }
    ]
  },
  "clients": [
    {
      "clientId": "nigson-bff",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "mock-bff-local-confidential-secret-32-bytes",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8081/bff/callback"
      ],
      "webOrigins": [
        "http://localhost:8081"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "exclude.issuer.from.auth.response": "true",
        "exclude.session.state.from.auth.response": "true"
      },
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-nigson-commerce",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "nigson-commerce",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false"
          }
        },
        {
          "name": "email_verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "false"
          }
        },
        {
          "name": "name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "nigson-commerce",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "mock-commerce-local",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
