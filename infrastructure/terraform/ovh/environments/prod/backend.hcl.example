# Precreate a private state bucket; use distinct state from AWS and other environments.
bucket = "REPLACE_PRIVATE_STATE_BUCKET"
key = "nigson/ovh/prod/terraform.tfstate"
region = "REPLACE_STORAGE_REGION"
endpoints = { s3 = "https://s3.REPLACE_STORAGE_REGION.io.cloud.ovh.net" }
skip_credentials_validation = true
skip_region_validation = true
skip_requesting_account_id = true
skip_metadata_api_check = true
use_path_style = true
use_lockfile = true
# Supply S3 state credentials through the environment, never this file.
