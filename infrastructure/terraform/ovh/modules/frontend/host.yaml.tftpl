#cloud-config
package_update: true
packages: [docker.io, docker-compose-v2]
ssh_pwauth: false
disable_root: true
write_files:
  - path: /etc/apt/apt.conf.d/99nigson-ipv4
    permissions: '0644'
    content: 'Acquire::ForceIPv4 "true";'
  - path: /etc/systemd/timesyncd.conf.d/nigson.conf
    permissions: '0644'
    content: |
      [Time]
      NTP=${join(" ", ntp_servers)}
      FallbackNTP=
  - path: /etc/nigson/frontend/nginx.conf
    permissions: '0644'
    content: |
      ${nginx_config}
  - path: /etc/nigson/frontend/compose.yaml
    permissions: '0644'
    content: |
      services:
        frontend:
          image: ${image}
          restart: unless-stopped
          read_only: true
          cap_drop: [ALL]
          security_opt: ["no-new-privileges:true"]
          pids_limit: 256
          mem_limit: 512m
          ports: ["${private_ip}:443:8443"]
          volumes:
            - /etc/nigson/frontend/nginx.conf:/etc/nginx/nginx.conf:ro
            - /etc/nigson/frontend/secrets:/run/secrets:ro
          tmpfs: ["/tmp:rw,noexec,nosuid,size=64m"]
          logging:
            driver: json-file
            options: { max-size: "10m", max-file: "3" }
          healthcheck:
            test: [CMD, wget, -q, -O, /dev/null, http://127.0.0.1:8080/healthz]
            interval: 30s
            timeout: 5s
            retries: 3
  - path: /etc/systemd/system/nigson-frontend.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Nigson microfrontend hosting
      Requires=docker.service
      After=docker.service network-online.target
      Wants=network-online.target
      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=/etc/nigson/frontend
      ExecStartPre=/usr/bin/test -s /etc/nigson/frontend/secrets/tls.crt
      ExecStartPre=/usr/bin/test -s /etc/nigson/frontend/secrets/tls.key
      ExecStart=/usr/bin/docker compose up -d --wait
      ExecStop=/usr/bin/docker compose stop
      TimeoutStartSec=600
      [Install]
      WantedBy=multi-user.target
runcmd:
  - [install, -d, -o, root, -g, '101', -m, '0750', /etc/nigson/frontend/secrets]
  - [systemctl, restart, systemd-timesyncd]
  - [systemctl, enable, --now, docker]
  - [systemctl, daemon-reload]
  - [systemctl, enable, nigson-frontend]
