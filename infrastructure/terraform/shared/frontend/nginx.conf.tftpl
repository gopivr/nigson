pid /tmp/nginx.pid;
worker_processes auto;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /dev/stdout;
  server_tokens off;
  map $uri $frontend_cache_control {
    default "no-cache";
    ~^/(api|bff)(/|$) "";
  }
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;
  server {
    listen 8080;
    location = /healthz { root /usr/share/nginx/html; try_files /index.html =503; access_log off; }
    location / { return 404; }
  }
  server {
    listen 8443 ssl;
    server_name ${domain};
    ssl_certificate /run/secrets/tls.crt;
    ssl_certificate_key /run/secrets/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Cache-Control $frontend_cache_control always;
    root /usr/share/nginx/html;
    index index.html;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location ~ ^/(internal|actuator)(/|$) { return 403; }
    location ~ ^/(api|bff)(/|$) {
      proxy_pass https://${backend};
      proxy_http_version 1.1;
      proxy_set_header Host ${backend};
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header Connection "";
      proxy_ssl_server_name on;
      proxy_ssl_name ${backend};
      proxy_ssl_verify on;
      proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
      proxy_cache off;
      proxy_intercept_errors off;
      proxy_read_timeout 60s;
      client_max_body_size 20m;
    }
    location ^~ /remotes/ { try_files $uri =404; }
    location ^~ /assets/ { try_files $uri =404; }
    location ~ \.[a-zA-Z0-9]+$ { try_files $uri =404; }
    location / { try_files $uri /index.html; }
  }
}
