NIGSON_SESSION_LOCAL_KEY=Clh43ZfAitX64P32LRBiq+iBrjYJdJlASahQ/KFLITM=

# Local application signup/sign-in endpoints; server-side only service credentials.
NIGSON_REGISTRATION_ENABLED=true
NIGSON_REGISTRATION_CLIENT_ID=nigson-registration
NIGSON_REGISTRATION_CLIENT_SECRET=mock-registration-local-secret-32-bytes
NIGSON_BFF_CALLBACK=http://localhost:4200/bff/callback
NIGSON_BFF_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8090
NIGSON_BFF_RETURN_PATHS=/,/account,/shop,/checkout,/admin

# Application runtime calls official live provider APIs. Configure real account
# values outside source control; application startup fails while these are blank.
PAYSTACK_MODE=TEST
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=sk_test_559fd8e0fc37bd609aef1657e6aeee5516456c51
