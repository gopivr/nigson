REVOKE ALL ON SCHEMA commerce FROM nigson_integration_app,nigson_integration_migrator,nigson_integration_audit;
REVOKE ALL ON SCHEMA commerce FROM nigson_ai_app,nigson_ai_migrator,nigson_ai_audit;
REVOKE ALL ON SCHEMA experience FROM nigson_commerce_app,nigson_commerce_migrator,nigson_commerce_audit;
REVOKE ALL ON SCHEMA experience FROM nigson_integration_app,nigson_integration_migrator,nigson_integration_audit;
