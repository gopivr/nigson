-- DATA-001. Run with psql -X -v ON_ERROR_STOP=1 using the infrastructure identity.
-- Supply each nigson_<owner>_{migrator,app}_password psql variable from Secrets Manager.
BEGIN;
DO $$ BEGIN
  IF current_database() <> 'nigson' OR current_setting('server_version_num')::int NOT BETWEEN 180000 AND 189999 THEN
    RAISE EXCEPTION 'Expected configured PostgreSQL 18 domain database';
  END IF;
END $$;
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
DO $$ BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='nigson_commerce_migrator') THEN
    CREATE ROLE nigson_commerce_migrator LOGIN;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='nigson_commerce_app') THEN
    CREATE ROLE nigson_commerce_app LOGIN;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='nigson_commerce_audit') THEN
    CREATE ROLE nigson_commerce_audit NOLOGIN;
  END IF;
END $$;
ALTER ROLE nigson_commerce_migrator NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
ALTER ROLE nigson_commerce_app NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
ALTER ROLE nigson_commerce_audit NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
ALTER ROLE nigson_commerce_migrator SET search_path=commerce;
ALTER ROLE nigson_commerce_app SET search_path=commerce;
ALTER ROLE nigson_commerce_audit SET search_path=commerce;
SELECT format('ALTER ROLE nigson_commerce_migrator PASSWORD %L', :'nigson_commerce_migrator_password') \gexec
SELECT format('ALTER ROLE nigson_commerce_app PASSWORD %L', :'nigson_commerce_app_password') \gexec
DO $$ BEGIN
  IF EXISTS (SELECT 1 FROM pg_namespace WHERE nspname='commerce' AND pg_get_userbyid(nspowner)<>'nigson_commerce_migrator') THEN
    RAISE EXCEPTION 'Unexpected schema owner: commerce';
  END IF;
END $$;
CREATE SCHEMA IF NOT EXISTS commerce AUTHORIZATION nigson_commerce_migrator;
REVOKE ALL ON SCHEMA commerce FROM PUBLIC;
REVOKE ALL ON SCHEMA commerce FROM nigson_commerce_app,nigson_commerce_audit;
GRANT USAGE ON SCHEMA commerce TO nigson_commerce_app,nigson_commerce_audit;

DO $$ BEGIN
